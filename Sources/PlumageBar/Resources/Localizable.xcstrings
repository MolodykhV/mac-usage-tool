        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS will only show alerts when Plumage Bar is allowed in Notifications. Ad-hoc-signed builds often need a manual grant in System Settings." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "macOS показывает уведомления только если Plumage Bar разрешён в Уведомлениях. Для ad-hoc-сборок обычно требуется ручное разрешение в Системных настройках." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "macOS n’affiche les alertes que si Plumage Bar est autorisé dans Notifications. Les versions signées ad-hoc nécessitent souvent une autorisation manuelle dans Réglages Système." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "macOS sólo muestra alertas si Plumage Bar está permitido en Notificaciones. Las versiones firmadas ad-hoc suelen requerir aprobación manual en Ajustes del Sistema." } },
